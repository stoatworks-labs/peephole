<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron needs these three for V8 and its helper processes. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- We ad-hoc sign (no Developer ID), and electron-builder enables the
         hardened runtime by default. Hardened runtime + an ad-hoc signature
         makes library validation reject every bundled dylib and the app dies
         on launch. This entitlement is what keeps it launchable. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The whole application. The hardened runtime restricts camera access
         regardless of TCC, so without this the app is granted the camera by
         the user and still cannot open it. It is also the entitlement that
         matters if this is ever sandboxed for the Mac App Store. -->
    <key>com.apple.security.device.camera</key>
    <true/>
  </dict>
</plist>
